  "version": 1,
  "nodes": [
    {
      "id": "coordinator",
      "role": "координатор",
      "provider": "opencode-go",
      "model": "deepseek-v4.1-flash",
      "brief": "ведёт план и раздаёт работу",
      "prompt": "Роль: координатор структуры — ведёт план, раздаёт задания исполнителям и собирает их результат. Definition of Done: план записан, у каждого задания есть исполнитель и срок, итог сверен с заказчиком и передан дальше. Долг обмена — это обязательство: адресованное письмо считать требованием, а не выбором; отметка «разобрал» ставится точечно по одному письму и соседних не закрывает; заявка (request/question) закрывается только письмом answer/ack с Reply-To или Ref на неё.",
      "x": 210,
      "y": 130
    },
    {
      "id": "worker",
      "role": "исполнитель",
      "provider": "opencode-go",
      "model": "deepseek-v4.1-flash",
      "brief": "делает основную работу",
      "prompt": "Роль: исполнитель — делает основную работу по заданию координатора. Definition of Done: результат собран, проверки и тесты пройдены, в отчёте названы файлы, команды и отклонения от задания.",
      "x": 1,
      "y": 378,
      "anchors": {
        "consumes": [
          "A2",
          "A4"
        ],
        "source": "coordinator"
      }
    },
    {
      "id": "judge",
      "role": "приёмщик",
      "provider": "opencode-go",
      "model": "glm-5.3-flash",
      "brief": "проверяет работу отдельной сессией",
      "prompt": "Роль: приёмщик — проверяет работу отдельной сессией по критериям задания. Definition of Done: вынесен вердикт принято или отклонено, каждое замечание подкреплено доказательством, код исполнителя не правится.",
      "x": 0,
      "y": 199,
      "anchors": {
        "consumes": [
          "A1",
          "A3",
          "A4"
        ],
        "source": "coordinator"
      }
    },
    {
      "id": "designer",
      "role": "исполнитель",
      "provider": "opencode-go",
      "model": "gpt-6-luna",
      "brief": "делает графику",
      "prompt": "Роль: дизайнер — отвечает за графику, интерфейс и подачу результата. Definition of Done: макеты и изображения соответствуют брифу, исходники и превью приложены, отклонения от брифа названы.",
      "x": 214,
      "y": 288,
      "anchors": {
        "consumes": [
          "A2",
          "A4"
        ],
        "source": "coordinator"
      }
    },
    {
      "id": "critic",
      "role": "критик",
      "provider": "opencode-go",
      "model": "glm-5.3-flash",
      "brief": "разбирает итоги дня по расписанию и возвращает аналитику координатору",
      "prompt": "Роль: критик — по расписанию разбирает итоги дня и возвращает аналитику координатору. При каждом запуске по расписанию сначала запусти node checks/self-control.mjs и впиши его вывод в docs/critic/<дата>.md: либо SELF-CONTROL OK, либо полный список нарушений — дословно, без пересказа. Definition of Done: вывод самоконтроля записан в docs/critic/<дата>.md, собраны факты дня, названы риски и узкие места, координатору отправлены выводы и рекомендации.",
      "schedule": {
        "at": "03:00",
        "timeZone": "Europe/Moscow"
      },
      "x": 0,
      "y": 26
    },
    {
      "id": "reviewer-1",
      "role": "ревьюер",
      "brief": "читает диф и контракт до приёмки",
      "x": 0,
      "y": 284,
      "provider": "deepseek-official",
      "model": "deepseek-flash",
      "prompt": "Роль: ревьюер — читает диф и контракт до приёмки, ничего не меняет.\nПроверь: критерии не ослаблены и не подогнаны под проверку; ошибки и пустые пути; секреты и внешние вызовы; тесты проверяют поведение, а не реализацию.\nКаждое замечание: файл:строка, серьёзность, почему, что чинить. Отдельно — список «не судил» с причиной.\nDefinition of Done: вердикт ok|issues, замечания с адресами, список «не судил»; дерево не изменено.",
      "anchors": {
        "consumes": [
          "A1",
          "A2",
          "A3",
          "A4",
          "A5",
          "A6",
          "A7",
          "A8",
          "A11",
          "A12"
        ]
      }
    },
    {
      "id": "tester-1",
      "role": "тестировщик",
      "brief": "независимый полный прогон",
      "prompt": "Роль: тестировщик — независимый прогон, код не правит.\nПрогони полный набор: node tools/test.mjs; затем точечные тесты задания. Если spawn-тесты падают EPERM, повтори тот же прогон с NODE_OPTIONS=--require docs/tasks/0194/pipe-capture.cjs.\nФиксируй: команда, exit, время, первая упавшая проверка; флак — только с доказательством повтора.\nDefinition of Done: команды и exit в отчёте, вердикт pass|fail, первое падение названо.",
      "schedule": {
        "at": "04:00",
        "timeZone": "Europe/Moscow"
      },
      "x": 209,
      "y": 28,
      "provider": "opencode-go",
      "model": "glm-5.3-flash"
