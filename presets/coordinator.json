{
  "node": "coordinator",
  "version": 1,
  "immutable": true,
  "pipeline": "project_graph_spawn",
  "requires": {
    "preflight": [
      "node tools/check-exchange.mjs"
    ],
    "evidence": [
      "coordination.json"
    ],
    "guard": {
      "enabled": true,
      "scope": "session",
      "reason": "координатор не пишет код задачи"
    }
  },
  "deny": [
    "git push",
    "publish-public",
    "npm publish"
  ],
  "secrets": "не печатать; значения только из окружения"
}
