{
  "node": "reviewer-1",
  "version": 1,
  "immutable": true,
  "pipeline": "project_graph_spawn",
  "requires": {
    "evidence": [
      "review.json"
    ],
    "guard": {
      "enabled": true,
      "scope": "session",
      "reason": "ревьюер ничего не меняет: только читает и выносит вердикт"
    }
  },
  "deny": [
    "git commit",
    "git push",
    "publish-public",
    "npm publish",
    "gh release create"
  ],
  "secrets": "не печатать; значения только из окружения"
}
