{
  "node": "judge",
  "version": 1,
  "immutable": true,
  "pipeline": "project_graph_spawn",
  "requires": {
    "preflight": [
      "node docs/subagent-workflow/scripts/task-verify.mjs"
    ],
    "evidence": [
      "acceptance.json"
    ],
    "guard": {
      "enabled": true,
      "scope": "session",
      "reason": "приёмщик подписывает, но не исполняет работу"
    }
  },
  "deny": [
    "git commit",
    "git push",
    "publish-public",
    "npm publish"
  ],
  "secrets": "не печатать; значения только из окружения"
}
