{
  "node": "tester-1",
  "version": 1,
  "immutable": true,
  "pipeline": "tools/test.mjs",
  "requires": {
    "preflight": [
      "node tools/test.mjs"
    ],
    "evidence": [
      "test-report.json"
    ],
    "guard": {
      "enabled": true,
      "scope": "session",
      "reason": "тестировщик не коммитит"
    }
  },
  "deny": [
    "git commit",
    "git push",
    "publish-public"
  ],
  "secrets": "не печатать; значения только из окружения"
}
